{
  "name": "dsh-mobile-fix",
  "version": "1.1.1",
  "description": "Mobile layout fixes for the DeepSeek Harness web UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DegreeCode/dsh-mobile-fix.git"
  },
  "homepage": "https://github.com/DegreeCode/dsh-mobile-fix#readme",
  "bugs": {
    "url": "https://github.com/DegreeCode/dsh-mobile-fix/issues"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mobile",
    "responsive"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:upstream": "node scripts/check-upstream.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
